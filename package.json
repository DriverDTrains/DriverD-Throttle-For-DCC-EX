{
  "name": "DriverD-Throttle",
  "private": true,
  "version": "1.4.20",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "shx rm -rf dist dist-electron",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development NODE_OPTIONS=--import=tsx electron electron/main.ts\"",
    "electron:build": "npm run build && esbuild electron/main.ts --bundle --platform=node --external:electron --external:express --external:ws --outfile=dist-electron/main.cjs --format=cjs && shx cp electron/preload.cjs dist-electron/preload.cjs && shx cp electron/DriverD-Throttle-Icon.png dist-electron/DriverD-Throttle-Icon.png && electron-builder",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.dcc-ex-throttle.driverd",
    "productName": "DriverD Throttle for DCC-EX",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "electron/DriverD-Throttle-Icon.png"
    },
    "mac": {
      "icon": "electron/DriverD-Throttle-Icon.png"
    },
    "linux": {
      "icon": "electron/DriverD-Throttle-Icon.png"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "driver.js": "^1.4.0",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "shx": "^0.3.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "wait-on": "^9.0.5"
  }
}
